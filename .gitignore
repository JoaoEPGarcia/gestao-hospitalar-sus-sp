# Arquivos brutos anuais do SIH (86 a 113 MB cada; excedem o limite do
# GitHub). Fonte: DataSUS/SIH SUS, extração da equipe. A planilha de
# classificação Barcelona (pequena) permanece versionada.
* - 2[0-9][0-9][0-9].xlsx

# Artefatos de execução
__pycache__/
*.pyc

# Saídas temporárias de compilação LaTeX
*.aux
*.log
*.out
*.toc
*.synctex.gz
# Registros de build do latexmk: mudam a cada compilação e não têm valor
# de revisão (principal.fdb_latexmk e principal.fls estavam versionados
# por engano e sujavam o git status a cada build).
*.fdb_latexmk
*.fls
# PDFs compilados: reproduzíveis a partir dos .tex, não se versionam.
analises/latex/principal.pdf
analises/latex/roteiro_entrevistas.pdf

# Junções locais para compilar com as figuras (no Overleaf as pastas
# são enviadas ao lado do principal.tex)
analises/latex/figuras_analise_exploratoria/
analises/latex/figuras_estimacao/
analises/latex/figuras_fase2/
analises/latex/figuras_selecao_entrevistas/

# Configuração local da sessão
.claude/
